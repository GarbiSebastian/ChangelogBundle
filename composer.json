{
    "name": "magyp/changelog-bundle",
    "description": "Visualización de CHANGELOG.md (Keep a Changelog) para proyectos Symfony",
    "type": "symfony-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Sebastián Garbi"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0",
        "symfony/framework-bundle": "^6.4|^7.0",
        "symfony/http-kernel": "^6.4|^7.0",
        "symfony/routing": "^6.4|^7.0",
        "symfony/twig-bundle": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "Magyp\\ChangelogBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Magyp\\ChangelogBundle\\Tests\\": "tests/"
        }
    }
}
